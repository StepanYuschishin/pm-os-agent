# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets, never commit API keys or agent credentials
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/

# Agent runtime artifacts you don't want public yet
*.local.json
/traces/
/runs/

00-build/credentials.json
00-build/token.json

# Cortex local scheduler logs
00-build/*.log
# Cortex job-search runtime state
00-build/job-search-classifications.json
00-build/job-search-classifications.backup.json
00-build/rejection-replies.json
